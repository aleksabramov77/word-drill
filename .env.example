# Word Drill — переменные окружения. Локально: скопировать в .env.local (pnpm dev читает его сам).
# На VM: /etc/words/app.env (systemd EnvironmentFile).

# --- Сервер ---
# Порт API (локально его выбирает pnpm dev, от 5100).
# PORT=5100
# Файл SQLite.
# DATABASE_PATH=data/app.db
# Словарь курса (pnpm dict:import).
# DICTIONARY_PATH=data/dictionary.json

# --- Вход через Google ---
# Без GOOGLE_CLIENT_ID локально работает один пользователь без входа (dev); в проде сервер не запустится.
# OAuth-клиент типа «Web application» в Google Cloud Console;
# Authorized redirect URI: <SITE_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Публичный адрес сайта без / в конце.
# SITE_URL=https://words.13.114.11.53.sslip.io
# Кого пускать: почты Google через запятую.
# ALLOWED_EMAILS=aleksabramov77@gmail.com
# Почта пользователя в dev-режиме.
# DEV_USER_EMAIL=local@localhost

# --- Уведомления (Web Push) ---
# Ключи VAPID: `pnpm vapid`. Создаются один раз — со сменой ключей все подписки перестают работать.
# Без ключей уведомления выключены.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Контакт для сервисов пушей (mailto: или https), по умолчанию SITE_URL.
# VAPID_SUBJECT=
