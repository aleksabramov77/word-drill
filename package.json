{
  "name": "word-drill",
  "version": "1.14.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && tsdown",
    "start": "NODE_ENV=production node dist/server.mjs",
    "dict:import": "tsx scripts/dict-import.ts",
    "wikt:import": "tsx scripts/wikt-import.ts",
    "db:generate": "drizzle-kit generate",
    "vapid": "tsx scripts/vapid.ts",
    "pwa:icons": "pwa-assets-generator",
    "lint": "biome check",
    "lint:fsd": "steiger ./src",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm lint:fsd && pnpm typecheck && pnpm test",
    "shortcut:build": "tsx scripts/build-shortcut.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.3",
    "arctic": "^3.7.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "steiger": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
